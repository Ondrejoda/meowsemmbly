// numbers loaded
LOAD 1 2
LOAD 2 5
LOAD 3 4
LOAD 4 3
LOAD 5 1
LOAD 6 9
LOAD 7 7
LOAD 8 10
LOAD 9 8
LOAD 10 6

// base loop parameters
LOAD 100 1
LOAD 101 1
LOAD 102 10

// main loop parameters
LOAD 110 1
LOAD 111 1
LOAD 112 10

// temp storage reg locations
LOAD 200 210
LOAD 201 211

// jump coords
LOAD 150 52
LOAD 151 58
LOAD 152 64
LOAD 153 70
LOAD 154 36

// main loop

// load two values based on index to temp area
PSWP 100 200
ADD 100 101 100
PSWP 100 201
SUB 100 101 100

// if right is greater, skip
GJMP 211 210 150

// swap them back swapped
PSWP 100 201
ADD 100 101 100
PSWP 100 200
SUB 100 101 100
JUMP 151

// swap them back normally
PSWP 100 200
ADD 100 101 100
PSWP 100 201
SUB 100 101 100

// increment loops
ADD 100 101 100
IJMP 100 102 152

JUMP 154

// progress second loop
LOAD 100 1
ADD 110 111 110
IJMP 110 112 153
JUMP 154

// end setup
PNUM 1
PNUM 2
PNUM 3
PNUM 4
PNUM 5
PNUM 6
PNUM 7
PNUM 8
PNUM 9
PNUM 10
NLIN
END