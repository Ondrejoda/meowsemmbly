// numbers loaded
OP_LOAD 1 2
OP_LOAD 2 5
OP_LOAD 3 4
OP_LOAD 4 3
OP_LOAD 5 1
OP_LOAD 6 9
OP_LOAD 7 7
OP_LOAD 8 10
OP_LOAD 9 8
OP_LOAD 10 6

// base loop parameters
OP_LOAD 100 1
OP_LOAD 101 1
OP_LOAD 102 10

// main loop parameters
OP_LOAD 110 1
OP_LOAD 111 1
OP_LOAD 112 10

// temp storage reg locations
OP_LOAD 200 210
OP_LOAD 201 211

// jump coords
OP_LOAD 150 52
OP_LOAD 151 58
OP_LOAD 152 64
OP_LOAD 153 70
OP_LOAD 154 36

// main loop

// load two values based on index to temp area
OP_PSWP 100 200
OP_ADD 100 101 100
OP_PSWP 100 201
OP_SUB 100 101 100

// if right is greater, skip
OP_GJMP 211 210 150

// swap them back swapped
OP_PSWP 100 201
OP_ADD 100 101 100
OP_PSWP 100 200
OP_SUB 100 101 100
OP_JUMP 151

// swap them back normally
OP_PSWP 100 200
OP_ADD 100 101 100
OP_PSWP 100 201
OP_SUB 100 101 100

// increment loops
OP_ADD 100 101 100
OP_IJMP 100 102 152

OP_JUMP 154

// progress second loop
OP_LOAD 100 1
OP_ADD 110 111 110
OP_IJMP 110 112 153
OP_JUMP 154

// end setup
OP_PNUM 1
OP_PNUM 2
OP_PNUM 3
OP_PNUM 4
OP_PNUM 5
OP_PNUM 6
OP_PNUM 7
OP_PNUM 8
OP_PNUM 9
OP_PNUM 10
OP_NLIN
OP_END