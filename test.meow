// numbers loaded
LOAD 1 2
LOAD 2 5
LOAD 3 4
LOAD 4 3
LOAD 5 1
LOAD 6 9
LOAD 7 7
LOAD 8 10
LOAD 9 8
LOAD 10 6

// loop values
LOAD 100 1
LOAD 110 1
LOAD 120 1

// main loop
: main

// load two values based on index to temp area
PSWP 100 200
ADD 100 .1 100
PSWP 100 201
SUB 100 .1 100

// if right is greater, skip
GJMP 201 200 mid_swap

// swap them back swapped
PSWP 100 201
ADD 100 .1 100
PSWP 100 200
SUB 100 .1 100
JUMP post_swap

// swap them back normally
: mid_swap

PSWP 100 200
ADD 100 .1 100
PSWP 100 201
SUB 100 .1 100

: post_swap

// increment first loop
ADD 100 .1 100

// jump back to start of main if loop isnt finished
UJMP 100 .10 main

// reset first loop and increment second loop
LOAD 100 1
ADD 110 .1 110
UJMP 110 .10 main

// end setup
: end

PSWP 120 202
PNUM 202
PSWP 120 202
ADD 120 .1 120
UJMP 120 .11 end

NLIN
END