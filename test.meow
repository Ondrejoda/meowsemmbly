// powers of two

// 1-10 are the numbers

// 1 reg for loop

LOAD 1 100
LOAD 2 100
LOAD 3 100

: init
LOAD 20 2

PSWP 1 20
ADD 1 .1 1
UJMP 1 .120 init

LOAD 1 100

: main

PSWP 1 20
MUL 20 .2 20
PSWP 1 20

ADD 1 .1 1
UJMP 1 .120 main

ADD 2 .1 2
COPY 2 1
UJMP 2 .120 main

: finish

PSWP 3 15
PNUM 15
NLIN
PSWP 3 15
ADD 3 .1 3
UJMP 3 .120 finish

// end
NLIN
END
