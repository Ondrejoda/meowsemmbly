// loop i
LOAD 110 1

// element count
LOAD 250 99

// E
LOAD 251 69

// empty to remove elements
LOAD 150 0

: start
ADD 220 110 220
PSWP 110 220 
ADD 110 .1 110
UJMP 110 250 start

// loop i and j
LOAD 110 2
LOAD 120 2

: pre_main

PCPY 110 200

: main

IJMP 120 200 increment

MOD 200 120 210

UJMP 210 .0 post_remove

PSWP 110 150
LOAD 150 0 

: post_remove

ADD 120 .1 120
JUMP main

: increment

ADD 110 .1 110
LOAD 120 2
UJMP 110 250 pre_main

LOAD 110 1

: end
PCPY 110 200
IJMP 200 .0 np
PNUM 200
NLIN
: np
ADD 110 .1 110
UJMP 110 250 end

NLIN
END
