// data
LOAD 1 2
LOAD 2 3
LOAD 3 5
LOAD 4 8
LOAD 5 10
LOAD 6 13
LOAD 7 18
LOAD 8 20
LOAD 9 25
LOAD 10 35
LOAD 11 50

// target
LOAD 200 8

// labels for debugging (G, L, E)
LOAD 250 71
LOAD 251 76
LOAD 252 69

// low and high bounds
LOAD 50 1
LOAD 51 11

LOAD 101 0

: main

// 1. Calculate pivot = (low + high) / 2
ADD 50 51 100
DIV 100 .2 100

// 2. Fetch array[pivot] into R101
PCPY 100 101

// 3. Compare array[pivot] (in R102) to target (in R200)
IJMP 101 200 end
GJMP 101 200 greater

// If array[pivot] < target: search right -> low = pivot + 1
PCHR 251
NLIN
ADD 100 .1 50
JUMP main

: greater
// If array[pivot] > target: search left -> high = pivot - 1
PCHR 250
NLIN
SUB 100 .1 51
JUMP main

: end
PCHR 252
NLIN
PNUM 100
NLIN
END