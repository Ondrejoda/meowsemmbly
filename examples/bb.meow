// loop i and rand range

LOAD 100 0
LOAD 250 1
LOAD 251 100

// element amount
LOAD 252 50

: begin

RAND 250 251 200
PNUM 200
SPAC
WRIT 200 100

ADD 100 .1 100
UJMP 100 252 begin


NLIN
NLIN

// loop values
LOAD 100 0
LOAD 110 0

SUB 252 .1 253

// main loop
: main

// load two values based on index to temp area
READ 100 200
ADD 100 .1 100
READ 100 201
SUB 100 .1 100

// if right is greater, skip
GJMP 201 200 post_swap

// swap them back swapped
WRIT 201 100
ADD 100 .1 100
WRIT 200 100
SUB 100 .1 100

: post_swap

// increment first loop
ADD 100 .1 100

// jump back to start of main if loop isnt finished
UJMP 100 253 main

// reset first loop and increment second loop
LOAD 100 0
ADD 110 .1 110
UJMP 110 253 main

// end setup

LOAD 120 0
: end

READ 120 200
PNUM 200
SPAC
ADD 120 .1 120
UJMP 120 252 end

NLIN
END