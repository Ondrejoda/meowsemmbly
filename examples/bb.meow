// setting aliases
@ r_min 250
@ r_max 251
@ element_amount 252
@ loop_boundary 253

@ loop 100
@ outer_loop 110

@ temp1 200
@ temp2 201

LOAD loop 0
LOAD r_min 1
LOAD r_max 100

LOAD element_amount 50

: begin

RAND r_min r_max temp1
PNUM temp1
SPAC
WRIT temp1 loop

ADD loop .1 loop
UJMP loop element_amount begin

NLIN
NLIN

// loop values
LOAD loop 0
LOAD outer_loop 0

SUB element_amount .1 loop_boundary

// main loop
: main

// load two values based on index to temp area
READ loop temp1
ADD loop .1 loop
READ loop temp2
SUB loop .1 loop

// if right is greater, skip
GJMP temp2 temp1 post_swap

// swap them back swapped
WRIT temp2 loop
ADD loop .1 loop
WRIT temp1 loop
SUB loop .1 loop

: post_swap

// increment first loop
ADD loop .1 loop

// jump back to start of main if loop isnt finished
UJMP loop loop_boundary main

// reset first loop and increment second loop
LOAD loop 0
ADD outer_loop .1 outer_loop
UJMP outer_loop loop_boundary main

// end setup

LOAD loop 0
: end

READ loop temp1
PNUM temp1
SPAC
ADD loop .1 loop
UJMP loop element_amount end

NLIN
END