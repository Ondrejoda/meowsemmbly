@ width 240
@ height 241

@ r 200
@ g 201
@ b 202

@ temp 210
@ temp1 211
@ temp2 212
@ temp3 213
@ temp4 214
@ temp5 215
@ temp6 216
@ temp7 217
@ temp8 218
@ temp9 219

@ zero 0

@ loop_x 220
@ loop_y 221

@ loopmax_x 222
@ loopmax_y 223

LOAD width 700
LOAD height 700 

LOAD r 255
LOAD g 0
LOAD b 255

ISDL width height

: main

LOAD temp 255

DIV loop_x .3 r
DIV loop_y .3 g

LOAD temp1 0

ADD temp1 r temp1
ADD temp1 g temp1

DIV temp1 .2 temp1

SUB temp temp1 b


SCOL r g b
DRAW loop_x loop_y

ADD loop_x .1 loop_x
UJMP loop_x width main

LOAD loop_x 0
ADD loop_y .1 loop_y
UJMP loop_y height main

FLSH
END